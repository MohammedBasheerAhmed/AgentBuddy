{
  "name": "agentbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Buddy: a privacy-first browser extension that helps ServiceNow fulfillers (ITSM, CSM, HR, catalog) and their team leads work tickets faster.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.js",
    "build:firefox": "node build.js --browser firefox",
    "build:enterprise": "node build.js --enterprise",
    "watch": "node build.js --watch",
    "test": "node tests/run.js",
    "e2e": "node build.js && node e2e/run.js",
    "e2e:firefox": "node build.js --browser firefox && node e2e/firefox/run.js",
    "e2e:edge": "node build.js && node e2e/edge.js",
    "check": "node scripts/check-compile.js",
    "i18n": "node scripts/i18n-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "eslint . && node tests/run.js && node scripts/check-compile.js && node scripts/traceability.js --check && node scripts/i18n-check.js",
    "sbom": "node scripts/sbom.js",
    "repro": "node scripts/repro-check.js",
    "hashes": "node scripts/hashes.js",
    "policy:check": "node scripts/check-policy.js",
    "traceability": "node scripts/traceability.js",
    "traceability:check": "node scripts/traceability.js --check",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.23.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "puppeteer-core": "25.16.0"
  }
}
